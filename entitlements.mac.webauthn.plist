<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements extra para passkeys (Touch ID) — NÃO usar no build padrão.
  Requer provisioning profile Apple com keychain-access-groups autorizado.
  Ver: https://www.electronjs.org/docs/latest/api/app#appconfigurewebauthnoptions-macos
-->
<plist version="1.0">
<dict>
  <key>keychain-access-groups</key>
  <array>
    <string>$(AppIdentifierPrefix)com.timworkspaces.app.webauthn</string>
  </array>
</dict>
</plist>
